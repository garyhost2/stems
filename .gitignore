__pycache__/
*.pyc
.venv/
.pytest_cache/

# Run logs and plots. Trained policy checkpoints under results/**/*_model/ ARE
# versioned: 8.5 MB total, and not reproducible without re-running training.
logs/
run_logs/
plots/
checkpoints/

# Scratch result directories
results/smoke_*/
results/check_*/

# Schemas are generated for the local CityLearn data folder by the setup_citylearn_*.py scripts
citylearn_schemas/*/schema.json
citylearn_schemas/_subsets/

# CityLearn source checkout created by setup_citylearn.sh
third_party/

# Local copy of the CityLearn dataset cache (142 MB, downloaded, never version this)
.citylearn_cache/

# Parallel-track worktrees (methods phase)
.worktrees/
.scratch/

# Written by scripts/resume.sh with machine-specific absolute paths
scripts/env.sh

# Session transcripts: kept locally, NOT published (this repo is public)
docs/sessions/
